# =====================================================================
# GitHub Linguist Overrides
# Force GitHub Linguist to ignore statutory HTML acts and json benchmarks
# so that the repository language breakdown accurately reflects Python.
# =====================================================================

*.html linguist-detectable=false
*.html linguist-vendored=true
*.html -whitespace
*.json linguist-detectable=false
data/** linguist-vendored=true
data/** linguist-detectable=false
data/** -whitespace
data/pobrane_ustawy/** -whitespace
data/pobrane_ustawy/*.html -whitespace -diff
static/** linguist-vendored=true
static/** linguist-detectable=false
ui.html linguist-detectable=false
eval_results.json linguist-detectable=false
