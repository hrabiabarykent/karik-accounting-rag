# ==============================================================================
# KARIK Accounting RAG - Environment Variables Template
# ==============================================================================

# Authentication & Security
KARIK_AUTH_SECRET=replace-with-at-least-32-characters-cryptographic-secret
KARIK_ENVIRONMENT=development
KARIK_ALLOW_EPHEMERAL_KEY=0
KARIK_ALLOW_DB_RESET=0

# Storage & Archive
STORAGE_BASE_DIR=./storage

# Redis Broker (Celery & Caching)
REDIS_URL=redis://127.0.0.1:16379/0
REDIS_PORT=16379

# PostgreSQL & pgvector Database
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=karik_db
POSTGRES_USER=karik_admin
POSTGRES_PASSWORD=your_secure_postgres_password_here
POSTGRES_SSLMODE=prefer

# Cloud LLM & AI Models
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.1-flash-lite

# Local AI / Gemma SLM (Optional, Profile: ml)
LOCAL_AI_URL=http://127.0.0.1:8088/v1
LOCAL_AI_MODEL=gemma4-e4b

# HuggingFace & PyTorch Offline Mode
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
EMBEDDING_MODEL=sdadas/mmlw-e5-base
RERANKER_MODEL=sdadas/polish-reranker-roberta-v3

# Background Dispatcher
KARIK_ENABLE_BACKGROUND_DISPATCHER=1
