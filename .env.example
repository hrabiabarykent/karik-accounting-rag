# API Key for Google Gemini
GEMINI_API_KEY=your_gemini_api_key_here

# Cloud Gemini model selection
GEMINI_MODEL=gemini-3.1-flash-lite

# Local llama-server endpoint (Gemma SLM)
LOCAL_AI_URL=http://local-ai:8080/v1

# Local model alias
LOCAL_AI_MODEL=gemma4-e4b

# PostgreSQL / pgvector connection settings
POSTGRES_HOST=postgres-pgvector
POSTGRES_PORT=5432
POSTGRES_DB=karik_db
POSTGRES_USER=karik_admin
POSTGRES_PASSWORD=your_secure_postgres_password_here
REDIS_PORT=16379

# LangFuse LLM Tracing & Observability (Optional)
# LANGFUSE_PUBLIC_KEY=pk-lf-123456789
# LANGFUSE_SECRET_KEY=sk-lf-123456789
# LANGFUSE_HOST=https://cloud.langfuse.com
